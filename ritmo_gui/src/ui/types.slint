// types.slint — struct condivise tra i componenti UI

export struct FieldDefinition {
    name: string,           // nome visualizzato, tradotto
    data-kind: string,      // "string" | "quantity" | "date" | "person" | "enum"
    enum-values: [string],  // popolato solo se data-kind == "enum"
}

export struct FieldEntry {
    field-name: string,
    data-kind: string,      // "string" | "quantity" | "date" | "person" | "enum"
    value: string,          // usato per string/quantity/date/enum
    person-id: int,         // usato se data-kind == "person"
    person-name: string,
    role-id: int,
    role-name: string,
}

export struct Suggestion {
    id: int,
    display-name: string,
}

export struct PersonEntry {
    person-id: int,
    person-name: string,
    role-id: int,
    role-name: string,
}
