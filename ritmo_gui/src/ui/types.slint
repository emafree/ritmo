// types.slint — struct condivise tra i componenti UI

export struct FieldDefinition {
    name: string,           // nome visualizzato, tradotto
    data-kind: string,      // "string" | "quantity" | "date" | "person" | "enum"
    enum-values: [string],  // popolato solo se data-kind == "enum"
}

export struct FieldEntry {
    field-name: string,
    data-kind: string,      // "string" | "quantity" | "date" | "person" | "enum"
    value: string,          // usato per string/quantity/date/enum
    person-id: int,         // usato se data-kind == "person"
    person-name: string,
    role-id: int,
    role-name: string,
}

export struct Suggestion {
    id: int,
    display-name: string,
}

export struct PersonEntry {
    person-id: int,
    person-name: string,
    role-id: int,
    role-name: string,
}

// ── Sidebar filter types ─────────────────────────────────────────────────────

// Un singolo valore attivo per una condizione di filtro
export struct FilterChip {
    label: string,   // testo mostrato nel chip, es. "Calvino"
}

// Una condizione all'interno di un filter-item (es. "autore = ...")
export struct FilterCondition {
    label: string,         // etichetta sinistra, es. "autore"
    chips: [FilterChip],   // valori attivi
}

// Un filter-item completo (es. "Autore") con più condizioni
export struct FilterItem {
    name:       string,              // nome mostrato nell'header, es. "Autore"
    is-active:  bool,                // true → header ha bg accent/active
    expanded:   bool,                // true → corpo visibile
    conditions: [FilterCondition],   // righe interne
}

// Un preset salvato
export struct SavedFilter {
    name: string,
}
