import { Theme } from "theme.slint";
import { Button } from "std-widgets.slint";
import { ComboBox, LineEdit, Button } from "std-widgets.slint";
import { Tr } from "tr.slint";

export component FilterRow inherits Rectangle {
    in property <[string]> fields: ["Titolo", "Autore", "Categoria"];
    in property <[string]> modes: ["=", "!=", "<", ">", "contiene"];
    in-out property <string> selected-field: "";
    in-out property <string> selected-mode: "";
    in-out property <string> value: "";
    callback delete-requested();

    height: Theme.filter-row-height;

    HorizontalLayout {
        spacing: Theme.spacing;

        ComboBox {
            model: root.fields;
            current-value <=> root.selected-field;
            width: Theme.filter-combobox-width;
        }

        ComboBox {
            model: root.modes;
            current-value <=> root.selected-mode;
            width: Theme.filter-combobox-mode-width;
        }

        LineEdit {
            text <=> root.value;
            width: Theme.filter-edit-width;
        }

        Button {
            text: "✕";
            width: Theme.filter-icon-size;
            height: Theme.filter-icon-size;
            clicked => {
                root.delete-requested();
            }
        }
    }
}

export component FilterDialog inherits Window {
    title: "Filtra libri";
    min-width: 420px;
    min-height: 220px;

    callback accepted();
    callback cancelled();
    callback continued();

    VerticalLayout {
        padding: Theme.padding;
        spacing: Theme.spacing;

        FilterRow { }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: Theme.spacing;
            alignment: end;

            Button {
                text: Tr.t.cancel;
                clicked => {
                    root.cancelled();
                }
            }

            Button {
                text: Tr.t.filter-continue;
                clicked => {
                    root.continued();
                }
            }

            Button {
                text: Tr.t.accept;
                clicked => {
                    root.accepted();
                }
            }
        }
    }
}
