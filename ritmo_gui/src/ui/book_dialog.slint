// book_dialog.slint
import { Palette } from "std-widgets.slint";
import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { FieldDefinition, FieldEntry, Suggestion } from "types.slint";
import { EntryRow } from "entry_row.slint";

// Riga singola nella lista contents
component ContentRow inherits Rectangle {
    in property <string> title;
    in property <string> author;
    callback edit-requested();
    callback delete-requested();

    height: Theme.filter-row-height;
    background: transparent;

    HorizontalLayout {
        spacing: Theme.spacing;

        Text {
            text: root.title + " — " + root.author;
            color: Palette.foreground;
            font-size: Theme.font-size-label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            width: 28px; height: 28px; background: transparent;
            Text {
                text: "✎"; font-size: 14px;
                color: Palette.foreground.transparentize(0.3);
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { width: 100%; height: 100%; clicked => { root.edit-requested(); } }
        }

        Rectangle {
            width: 28px; height: 28px; background: transparent;
            Text {
                text: "✕"; font-size: 14px;
                color: Palette.foreground.transparentize(0.3);
                horizontal-alignment: center; vertical-alignment: center;
                width: parent.width; height: parent.height;
            }
            TouchArea { width: 100%; height: 100%; clicked => { root.delete-requested(); } }
        }
    }
}

export struct ContentSummary {
    title: string,
    author: string,
}

export component BookDialog inherits Window {
    title: Tr.t.new-book;
    min-width: 480px;
    min-height: 300px;

    in property <[string]> available-field-names;
    in property <[FieldDefinition]> available-fields;
    in property <[FieldEntry]> entries;
    in property <[Suggestion]> name-suggestions;
    in property <[Suggestion]> role-suggestions;
    in property <[ContentSummary]> added-contents;

    callback accepted();
    callback cancelled();
    callback value-changed(int, FieldEntry);
    callback field-selected(int, string);
    callback delete-requested(int);
    callback name-text-changed(int, string);
    callback name-selected(int, int);
    callback name-create-requested(int, string);
    callback role-text-changed(int, string);
    callback role-selected(int, int);
    callback role-create-requested(int, string);
    callback add-content-requested();
    callback edit-content-requested(int);
    callback delete-content-requested(int);

    VerticalLayout {
        spacing: 0px;

        // ── Sezione dati book ─────────────────────────────────────
        Rectangle {
            background: Palette.background;

            VerticalLayout {
                padding: Theme.padding;
                spacing: Theme.spacing;

                for entry[i] in root.entries: EntryRow {
                    available-field-names: root.available-field-names;
                    available-fields: root.available-fields;
                    name-suggestions: root.name-suggestions;
                    role-suggestions: root.role-suggestions;
                    entry: entry;
                    is-placeholder: entry.value == "" && entry.person-name == "" && i == root.entries.length - 1;
                    is-required: false;
                    value-changed(e) => { root.value-changed(i, e); }
                    field-selected(name) => { root.field-selected(i, name); }
                    delete-requested => { root.delete-requested(i); }
                    name-text-changed(t) => { root.name-text-changed(i, t); }
                    name-selected(id) => { root.name-selected(i, id); }
                    name-create-requested(t) => { root.name-create-requested(i, t); }
                    role-text-changed(t) => { root.role-text-changed(i, t); }
                    role-selected(id) => { root.role-selected(i, id); }
                    role-create-requested(t) => { root.role-create-requested(i, t); }
                }
            }
        }

        // ── Sezione lista contents ────────────────────────────────
        Rectangle {
            background: Theme.sidebar-bg;
            vertical-stretch: 1;

            VerticalLayout {
                padding: Theme.padding;
                spacing: Theme.spacing;

                Text {
                    text: Tr.t.contents;
                    color: Palette.foreground.transparentize(0.4);
                    font-size: Theme.font-size-section;
                }

                for content[i] in root.added-contents: ContentRow {
                    title: content.title;
                    author: content.author;
                    edit-requested => { root.edit-content-requested(i); }
                    delete-requested => { root.delete-content-requested(i); }
                }

                Rectangle {
                    height: Theme.filter-row-height;
                    background: transparent;
                    Text {
                        text: "+ " + Tr.t.new-content;
                        color: Palette.foreground.transparentize(0.5);
                        font-size: Theme.font-size-label;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    TouchArea {
                        width: 100%; height: 100%;
                        clicked => { root.add-content-requested(); }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        // ── Bottoni ───────────────────────────────────────────────
        Rectangle {
            background: Palette.background;
            height: 52px;

            HorizontalLayout {
                alignment: end;
                padding: Theme.padding;
                spacing: Theme.spacing;

                Button {
                    text: Tr.t.cancel;
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: Tr.t.save;
                    clicked => { root.accepted(); }
                }
            }
        }
    }
}
