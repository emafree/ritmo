import { ComboBox, LineEdit, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component FilterRow inherits Rectangle {
    in property <[string]> fields: ["Titolo", "Autore", "Categoria"];
    in property <[string]> modes: ["=", "!=", "<", ">", "contiene"];
    in-out property <string> selected-field: "";
    in-out property <string> selected-mode: "";
    in-out property <string> value: "";
    callback delete-requested();

    height: Theme.filter-row-height;

    HorizontalLayout {
        spacing: Theme.spacing;

        ComboBox {
            model: root.fields;
            current-value <=> root.selected-field;
            width: Theme.filter-combobox-width;
        }

        ComboBox {
            model: root.modes;
            current-value <=> root.selected-mode;
            width: Theme.filter-combobox-mode-width;
        }

        LineEdit {
            text <=> root.value;
            width: Theme.filter-edit-width;
        }

        Button {
            text: "✕";
            width: Theme.filter-icon-size;
            height: Theme.filter-icon-size;
            clicked => { root.delete-requested(); }
        }
    }
}
