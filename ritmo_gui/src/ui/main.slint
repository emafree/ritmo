import { Palette } from "std-widgets.slint";
import { Theme, SegmentedButton, SegmentedIconButton } from "theme.slint";
import { Tr } from "tr.slint";

//export { Tr }
export { Tr } from "tr.slint";

export component MainWindow inherits Window {
    title: "App";
    min-width: 800px;
    min-height: 600px;

    in property <string> library-name: "La mia libreria";
    in-out property <bool> show-books: true;
    in-out property <bool> show-grid: true;

    callback request-add-book();
    callback main-nav();

    HorizontalLayout {
        spacing: 0px;

        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.sidebar-bg;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: Theme.header-height;
                    background: transparent;

                    Text {
                        text: Tr.t.app-name;
                        color: Palette.foreground;
                        font-size: Theme.font-size-app-title;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }

                    Rectangle {
                        x: parent.width - self.width - 8px;
                        y: (parent.height - self.height) / 2;
                        width: 32px;
                        height: 32px;
                        background: transparent;

                        Text {
                            text: "☰";
                            font-size: 18px;
                            color: Palette.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }

                        TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => {
                                root.main-nav();
                            }
                        }
                    }
                }
            }

            SegmentedButton {
                x: parent.width - self.width - Theme.padding;
                y: parent.height - self.height - Theme.padding;
                label-left: Tr.t.books;
                label-right: Tr.t.contents;
                left-selected: root.show-books;
                changed(v) => {
                    root.show-books = v;
                }
            }
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: Theme.header-height;
                background: Palette.background;

                HorizontalLayout {
                    alignment: space-between;
                    padding-left: Theme.padding;
                    padding-right: Theme.padding;

                    Rectangle {
                        width: 32px;
                    }

                    Text {
                        text: root.library-name;
                        color: Palette.foreground.transparentize(0.2);
                        font-size: Theme.font-size-label;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;
                        width: 100px;

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: transparent;
                            Text {
                                text: "+";
                                font-size: 20px;
                                color: Palette.foreground;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.request-add-book();
                                }
                            }
                        }

                        SegmentedIconButton {
                            icon-left: @image-url("icons/grid.svg");
                            icon-right: @image-url("icons/list.svg");
                            left-selected: root.show-grid;
                            changed(v) => {
                                root.show-grid = v;
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: Palette.background;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.show-books ? Tr.t.books : Tr.t.contents;
                        color: Palette.foreground.transparentize(0.5);
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}
