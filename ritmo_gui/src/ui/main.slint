import { Theme, SegmentedButton, SegmentedIconButton } from "theme.slint";
import { Tr } from "tr.slint";
import { FilterSidebar, FilterItem, FilterCondition, FilterChip, SavedFilter } from "sidebar.slint";

//export { Tr }
export { Tr } from "tr.slint";
export { Theme } from "theme.slint";
export { FieldDefinition, FieldEntry, Suggestion } from "types.slint";
export { BookDialog, ContentSummary } from "book_dialog.slint";
export { ContentDialog } from "content_dialog.slint";
export { FilterDialog } from "filter_dialog.slint";
export { PersonEntry } from "types.slint";
export { OptionsDialog } from "options_dialog.slint";
export { FilterItem, FilterCondition, FilterChip, SavedFilter } from "sidebar.slint";

export component MainWindow inherits Window {
    title: "App";
    background: Theme.colors.bg;
    min-width: 800px;
    min-height: 600px;

    in property <string> library-name: "La mia libreria";
    in-out property <bool> show-books: true;
    in-out property <bool> show-grid: true;

    // ── Sidebar filter data ──────────────────────────────────────────────────
    in-out property <[FilterItem]> filter-items;
    in     property <[SavedFilter]> saved-filters;

    callback request-add-book();
    callback request-add-person();
    callback request-filter();
    callback main-nav();
    callback request-options();

    // ── Sidebar filter callbacks ─────────────────────────────────────────────
    callback add-filter-requested();
    callback filter-item-toggle(int);
    callback filter-chip-remove(int, int, int);
    callback filter-condition-add(int, int);
    callback filter-item-reset(int);
    callback filter-item-delete(int);
    callback saved-filter-apply(int);

    HorizontalLayout {
        spacing: 0px;

        // ── Sidebar ──────────────────────────────────────────────────────────
        FilterSidebar {
            width: Theme.sidebar-width;
            filter-items <=> root.filter-items;
            saved-filters: root.saved-filters;

            add-filter-requested => { root.add-filter-requested(); }
            filter-item-toggle(i) => { root.filter-item-toggle(i); }
            filter-chip-remove(i, ci, ki) => { root.filter-chip-remove(i, ci, ki); }
            filter-condition-add(i, ci) => { root.filter-condition-add(i, ci); }
            filter-item-reset(i) => { root.filter-item-reset(i); }
            filter-item-delete(i) => { root.filter-item-delete(i); }
            saved-filter-apply(si) => { root.saved-filter-apply(si); }
        }

        // sidebar right border
        Rectangle {
            width: 1px;
            background: Theme.colors.border;
        }

        // ── Main content area ────────────────────────────────────────────────
        VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: Theme.header-height;
                background: Theme.colors.bg;

                HorizontalLayout {
                    alignment: space-between;
                    padding-left: Theme.padding;
                    padding-right: Theme.padding;

                    Rectangle {
                        width: 32px;
                    }

                    Text {
                        text: root.library-name;
                        color: Theme.colors.text-secondary;
                        font-size: Theme.font-size-label;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;
                        width: 260px;

                        // ── Libri / Contenuti toggle (moved from sidebar) ──────
                        SegmentedButton {
                            label-left: Tr.t.books;
                            label-right: Tr.t.contents;
                            left-selected: root.show-books;
                            changed(v) => {
                                root.show-books = v;
                            }
                        }

                        // ── "+" Button ────────────────────────────────────────
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: transparent;

                            Text {
                                text: "+";
                                font-size: 20px;
                                color: Theme.colors.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.request-add-book();
                                }
                            }
                        }

                        // ── "⋮" Options Button (sushi menu) ──────────────────
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            background: options-touch.has-hover
                                ? Theme.colors.text-primary.transparentize(0.85)
                                : transparent;

                            animate background {
                                duration: 100ms;
                            }

                            Text {
                                text: "⋮";
                                font-size: 16px;
                                color: Theme.colors.text-primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }

                            options-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.request-options();
                                }
                            }
                        }

                        // ── Grid / List Toggle ────────────────────────────────
                        SegmentedIconButton {
                            icon-left: @image-url("icons/grid.svg");
                            icon-right: @image-url("icons/list.svg");
                            left-selected: root.show-grid;
                            changed(v) => {
                                root.show-grid = v;
                            }
                        }
                    }
                }
            }

            Rectangle {
                background: Theme.colors.bg;

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.show-books ? Tr.t.books : Tr.t.contents;
                        color: Theme.colors.text-muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}