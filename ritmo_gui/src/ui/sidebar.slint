// sidebar.slint — FilterSidebar component
import { Theme } from "theme.slint";
import { Tr } from "tr.slint";
import { FilterChip, FilterCondition, FilterItem, SavedFilter } from "types.slint";

export { FilterChip, FilterCondition, FilterItem, SavedFilter } from "types.slint";

export component FilterSidebar inherits Rectangle {
    in-out property <[FilterItem]> filter-items;
    in     property <[SavedFilter]> saved-filters;

    callback add-filter-requested();
    callback filter-item-toggle(int);           // toggle espanso/collassato
    callback filter-chip-remove(int, int, int); // item-idx, cond-idx, chip-idx
    callback filter-condition-add(int, int);    // item-idx, cond-idx
    callback filter-item-reset(int);
    callback filter-item-delete(int);
    callback saved-filter-apply(int);

    background: Theme.colors.surface;

    VerticalLayout {
        spacing: 0px;

        // ── Section: FILTRI ATTIVI ───────────────────────────────────────────
        VerticalLayout {
            spacing: 0px;
            padding-top: 12px;
            padding-bottom: 12px;

            // Section title
            Text {
                text: Tr.t.sidebar-active-filters;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.2px;
                color: Theme.colors.text-muted;
                height: 18px;
                padding-left: 14px;
                padding-bottom: 8px;
                vertical-alignment: bottom;
            }

            // Filter items list
            for item[i] in root.filter-items: VerticalLayout {
                spacing: 0px;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 2px;
                padding-bottom: 2px;

                // Filter item container with border
                Rectangle {
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: item.is-active ? Theme.colors.accent2 : Theme.colors.border;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;

                        // ── Filter header ──────────────────────────────────
                        Rectangle {
                            height: 30px;
                            background: item.is-active
                                ? Theme.colors.active-bg
                                : header-touch.has-hover
                                    ? Theme.colors.surface3
                                    : Theme.colors.surface2;
                            border-radius: 6px;

                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                spacing: 8px;
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;

                                // filter-dot
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: Theme.colors.accent;
                                    vertical-stretch: 0;
                                }

                                // filter-name
                                Text {
                                    text: item.name;
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.colors.text-primary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                // filter-toggle arrow
                                Text {
                                    text: item.expanded ? "▼" : "▶";
                                    font-size: 10px;
                                    color: Theme.colors.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            header-touch := TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    root.filter-item-toggle(i);
                                }
                            }
                        }

                        // ── Filter body (expanded) ─────────────────────────
                        if item.expanded: VerticalLayout {
                            spacing: 0px;

                            // top border
                            Rectangle {
                                height: 1px;
                                background: Theme.colors.border;
                            }

                            // body content
                            Rectangle {
                                background: Theme.colors.surface;

                                VerticalLayout {
                                    spacing: 6px;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;

                                    // sublabel "CAMPO"
                                    Text {
                                        text: Tr.t.sidebar-field;
                                        font-size: 10px;
                                        font-weight: 600;
                                        letter-spacing: 0.8px;
                                        color: Theme.colors.text-muted;
                                        height: 14px;
                                        vertical-alignment: center;
                                    }

                                // condition rows
                                for cond[ci] in item.conditions: Rectangle {
                                    height: 26px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Theme.colors.border;
                                    background: Theme.colors.surface2;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;

                                        // row label
                                        Text {
                                            text: cond.label;
                                            font-size: 11px;
                                            color: Theme.colors.text-muted;
                                            min-width: 48px;
                                            vertical-alignment: center;
                                        }

                                        // chips
                                        for chip[ki] in cond.chips: Rectangle {
                                            height: 18px;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: Theme.colors.accent2;
                                            background: Theme.colors.active-bg;

                                            HorizontalLayout {
                                                spacing: 3px;
                                                padding-left: 7px;
                                                padding-right: 4px;
                                                alignment: center;

                                                Text {
                                                    text: chip.label;
                                                    font-size: 10px;
                                                    color: Theme.colors.accent;
                                                    vertical-alignment: center;
                                                }

                                                // ✕ remove button
                                                Rectangle {
                                                    width: 14px;
                                                    height: 14px;
                                                    border-radius: 2px;
                                                    background: chip-remove.has-hover
                                                        ? Theme.colors.surface3
                                                        : transparent;

                                                    Text {
                                                        text: "✕";
                                                        font-size: 9px;
                                                        color: Theme.colors.accent;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                        width: parent.width;
                                                        height: parent.height;
                                                    }

                                                    chip-remove := TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        clicked => {
                                                            root.filter-chip-remove(i, ci, ki);
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // "+" add chip button
                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            border-radius: 3px;
                                            background: add-chip-touch.has-hover
                                                ? Theme.colors.surface3
                                                : transparent;

                                            Text {
                                                text: "+";
                                                font-size: 12px;
                                                color: Theme.colors.text-muted;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                width: parent.width;
                                                height: parent.height;
                                            }

                                            add-chip-touch := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                clicked => {
                                                    root.filter-condition-add(i, ci);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ── Filter actions bar ─────────────────────────
                            Rectangle {
                                height: 1px;
                                background: Theme.colors.border;
                            }

                            Rectangle {
                                background: Theme.colors.surface2;

                                HorizontalLayout {
                                    spacing: 6px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 6px;
                                    padding-bottom: 6px;

                                    // reset button
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: reset-touch.has-hover
                                            ? Theme.colors.border2
                                            : Theme.colors.border;
                                        background: transparent;

                                        Text {
                                            text: Tr.t.sidebar-reset;
                                            font-size: 10px;
                                            color: reset-touch.has-hover
                                                ? Theme.colors.text-secondary
                                                : Theme.colors.text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }

                                        reset-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => {
                                                root.filter-item-reset(i);
                                            }
                                        }
                                    }

                                    // delete button
                                    Rectangle {
                                        height: 22px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: delete-touch.has-hover
                                            ? Theme.colors.danger
                                            : Theme.colors.border;
                                        background: transparent;

                                        Text {
                                            text: Tr.t.sidebar-delete-filter;
                                            font-size: 10px;
                                            color: delete-touch.has-hover
                                                ? Theme.colors.danger
                                                : Theme.colors.text-muted;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: parent.width;
                                            height: parent.height;
                                        }

                                        delete-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            clicked => {
                                                root.filter-item-delete(i);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── "Add filter" button ──────────────────────────────────────────
            Rectangle {
                height: 48px;
                background: transparent;

                Rectangle {
                    height: 32px;
                    y: 8px;
                    x: 8px;
                    width: parent.width - 16px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: add-filter-touch.has-hover
                        ? Theme.colors.accent
                        : Theme.colors.border2;
                    background: transparent;

                    Text {
                        text: Tr.t.sidebar-add-filter;
                        font-size: 12px;
                        color: add-filter-touch.has-hover
                            ? Theme.colors.accent
                            : Theme.colors.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }

                    add-filter-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.add-filter-requested();
                        }
                    }
                }
            }
        }

        // section separator
        Rectangle {
            height: 1px;
            background: Theme.colors.border;
        }

        // ── Section: PRESET ──────────────────────────────────────────────────
        VerticalLayout {
            spacing: 0px;
            padding-top: 12px;
            padding-bottom: 12px;

            // Section title
            Text {
                text: Tr.t.sidebar-preset;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.2px;
                color: Theme.colors.text-muted;
                height: 18px;
                padding-left: 14px;
                padding-bottom: 8px;
                vertical-alignment: bottom;
            }

            // Saved filter items
            for sf[si] in root.saved-filters: Rectangle {
                height: 30px;
                background: sf-touch.has-hover
                    ? Theme.colors.surface2
                    : transparent;

                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 14px;
                    padding-right: 14px;
                    alignment: center;

                    // icon ◈
                    Text {
                        text: "◈";
                        font-size: 11px;
                        color: Theme.colors.accent;
                        vertical-alignment: center;
                    }

                    // filter name
                    Text {
                        text: sf.name;
                        font-size: 12px;
                        color: Theme.colors.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                sf-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    clicked => {
                        root.saved-filter-apply(si);
                    }
                }
            }
        }

        // vertical spacer
        Rectangle {
            vertical-stretch: 1;
        }
    }
}