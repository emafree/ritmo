// theme.slint
import { Palette } from "std-widgets.slint";

export global Theme {
    // Struttura
    out property <length> header-height: 48px;
    out property <length> sidebar-width: 240px;
    out property <length> sidebar-item-height: 32px;

    // Dettagli
    out property <length> border-radius: 4px;

    // Spaziatura
    out property <length> padding: 12px;
    out property <length> spacing: 4px;

    // Tipografia
    out property <length> font-size-app-title: 14px;
    out property <length> font-size-label: 13px;
    out property <length> font-size-section: 11px;

    // Filtri
    out property <length> filter-row-height: 32px;
    out property <length> filter-icon-size: 28px;
    out property <length> filter-combobox-width: 240px;
    out property <length> filter-combobox-mode-width: 120px;
    out property <length> filter-edit-width: 280px;

    // Colori
    out property <color> sidebar-bg: Palette.background.darker(0.06);
}

export component SegmentedButton inherits Rectangle {
    in property <string> label-left;
    in property <string> label-right;
    in-out property <bool> left-selected: true;
    callback changed(bool);  // true = sinistra, false = destra

    height: 28px;
    width: 120px;
    border-radius: 6px;
    background: Palette.background.darker(0.08);

    // Indicatore selezionato
    Rectangle {
        x: root.left-selected ? 2px : parent.width / 2;
        y: 2px;
        width: parent.width / 2 - 2px;
        height: parent.height - 4px;
        border-radius: 5px;
        background: Palette.background;
        animate x {
            duration: 150ms;
            easing: ease-in-out;
        }
    }

    // Label sinistra
    Text {
        x: 0;
        y: 0;
        width: parent.width / 2;
        height: parent.height;
        text: root.label-left;
        font-size: Theme.font-size-section;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.left-selected ? Palette.foreground : Palette.foreground.transparentize(0.4);
    }

    // Label destra
    Text {
        x: parent.width / 2;
        y: 0;
        width: parent.width / 2;
        height: parent.height;
        text: root.label-right;
        font-size: Theme.font-size-section;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.left-selected ? Palette.foreground : Palette.foreground.transparentize(0.4);
    }

    // Touch area sinistra
    TouchArea {
        x: 0;
        width: parent.width / 2;
        height: parent.height;
        clicked => {
            root.left-selected = true;
            root.changed(true);
        }
    }

    // Touch area destra
    TouchArea {
        x: parent.width / 2;
        width: parent.width / 2;
        height: parent.height;
        clicked => {
            root.left-selected = false;
            root.changed(false);
        }
    }
}

export component SegmentedIconButton inherits Rectangle {
    in property <image> icon-left;
    in property <image> icon-right;
    in-out property <bool> left-selected: true;
    callback changed(bool);

    height: 28px;
    width: 64px;
    border-radius: 6px;
    background: Palette.background.darker(0.08);

    // Indicatore selezionato
    Rectangle {
        x: root.left-selected ? 2px : parent.width / 2;
        y: 2px;
        width: parent.width / 2 - 2px;
        height: parent.height - 4px;
        border-radius: 5px;
        background: Palette.background;
        animate x {
            duration: 150ms;
            easing: ease-in-out;
        }
    }

    // Icona sinistra
    Image {
        x: parent.width / 4 - 8px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon-left;
        colorize: root.left-selected ? Palette.foreground : Palette.foreground.transparentize(0.4);
    }

    // Icona destra
    Image {
        x: parent.width * 3 / 4 - 8px;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        source: root.icon-right;
        colorize: !root.left-selected ? Palette.foreground : Palette.foreground.transparentize(0.4);
    }

    // Touch area sinistra
    TouchArea {
        x: 0;
        width: parent.width / 2;
        height: parent.height;
        clicked => {
            root.left-selected = true;
            root.changed(true);
        }
    }

    // Touch area destra
    TouchArea {
        x: parent.width / 2;
        width: parent.width / 2;
        height: parent.height;
        clicked => {
            root.left-selected = false;
            root.changed(false);
        }
    }
}
